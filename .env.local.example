NEXT_PUBLIC_GA_ID=G-8LW2SC8PFE

# --- Vercel 배포 환경 설정 ---
# 1. Vercel Dashboard → 프로젝트 선택 → Settings → Environment Variables
# 2. Add New:
#      Name:  NEXT_PUBLIC_GA_ID
#      Value: G-8LW2SC8PFE
# 3. 적용 환경: Production (필요 시 Preview, Development도 동일하게 추가)
# 4. Save 후 Redeploy (환경 변수는 새 배포부터 반영됩니다)
# 5. GA4 Realtime 보고서에서 접속 이벤트로 연동 확인
