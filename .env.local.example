# Google Analytics 4 (GA4)
# 로컬: 이 파일을 복사해 .env.local 로 저장한 뒤 값을 확인하세요.
#   cp .env.local.example .env.local
NEXT_PUBLIC_GA_ID=G-8LW2SC8PFE


# Site URL (sitemap / canonical)
NEXT_PUBLIC_SITE_URL=https://sajangman.vercel.app

# Supabase — bomstudio-clients-db 프로젝트 값을 사용하세요.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 privileged key (절대 NEXT_PUBLIC_ 붙이지 말 것 / Client에 import 금지)
# 둘 중 하나만 있으면 됩니다. 이 프로젝트는 SUPABASE_SERVICE_ROLE_KEY를 권장합니다.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Vercel 배포 환경 설정 ---
# 1. Vercel Dashboard → 프로젝트 선택 → Settings → Environment Variables
# 2. Production에 반드시 추가 (Preview에도 동일 권장):
#      NEXT_PUBLIC_SUPABASE_URL
#      NEXT_PUBLIC_SUPABASE_ANON_KEY          ← 브라우저용(선택, Stats와 무관)
#      SUPABASE_SERVICE_ROLE_KEY             ← 서버 전용 (또는 SUPABASE_SECRET_KEY)
# 3. Environment = Production 체크 확인 후 Save → Redeploy
# 4. Vercel Logs에서 `[visitors:home]` / `[visitors] getTotalVisitCount` 확인
#    hasServiceRoleKey:false 이면 Production에 키가 없는 것입니다.
